{
  "name": "@ensim/sim-services",
  "version": "0.1.0",
  "private": true,
  "description": "Discrete-event scenario runner for ENSIM missions. See docs/architecture/ARCHITECTURE.md Section 11.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate-types": "node scripts/generate-types.mjs",
    "run-mission": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test dist/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ensim/org-doctrine-model": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.5.4"
  }
}
